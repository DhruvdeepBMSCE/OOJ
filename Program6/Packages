package CIE;

public class Personal {
    String name;
    String usn;
    int sem;

    public Personal(String name, String usn, int sem) {
        this.name = name;
        this.usn = usn;
        this.sem = sem;
    }

    public String getName() {
        return name;
    }

    public String getUsn() {
        return usn;
    }

    public int getSem() {
        return sem;
    }
}

public class Internals {
    Personal personalDetails;  // Contains personal details
    int[] internalMarks = new int[5];  // Stores 5 internal marks

    public Internals(Personal personalDetails) {
        this.personalDetails = personalDetails;
    }

    public void setInternalMarks(int[] marks) {
        for (int i = 0; i < 5; i++) {
            internalMarks[i] = marks[i];
        }
    }

    public int[] getInternalMarks() {
        return internalMarks;
    }

    public String getName() {
        return personalDetails.getName();
    }

    public String getUsn() {
        return personalDetails.getUsn();
    }

    public int getSem() {
        return personalDetails.getSem();
    }
}



package SEE;

import CIE.Internals;
import CIE.Personal;
import java.util.Scanner;

public class External extends Internals {
    int[] externalMarks = new int[5];  // Stores 5 external marks

    public External(Personal personalDetails) {
        super(personalDetails);
    }

    public void setExternalMarks(int[] marks) {
        for (int i = 0; i < 5; i++) {
            externalMarks[i] = marks[i];
        }
    }

    public int[] getExternalMarks() {
        return externalMarks;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter the number of students: ");
        int n = sc.nextInt();

        External[] students = new External[n];

        for (int i = 0; i < n; i++) {
            System.out.println("Enter details for student " + (i + 1) + ":");

            System.out.print("Name: ");
            sc.nextLine();  // consume newline
            String name = sc.nextLine();

            System.out.print("USN: ");
            String usn = sc.nextLine();

            System.out.print("Semester: ");
            int sem = sc.nextInt();

            Personal personalDetails = new Personal(name, usn, sem);
            students[i] = new External(personalDetails);

            System.out.println("Enter 5 internal marks: ");
            int[] internalMarks = new int[5];
            for (int j = 0; j < 5; j++) {
                internalMarks[j] = sc.nextInt();
            }
            students[i].setInternalMarks(internalMarks);

            System.out.println("Enter 5 external marks: ");
            int[] externalMarks = new int[5];
            for (int j = 0; j < 5; j++) {
                externalMarks[j] = sc.nextInt();
            }
            students[i].setExternalMarks(externalMarks);
        }

        System.out.println("\nFinal Marks Details:");
        for (int i = 0; i < n; i++) {
            System.out.println("Student " + (i + 1) + ": USN = " + students[i].getUsn() + ", Name = " + students[i].getName() + ", Semester = " + students[i].getSem());
            for (int j = 0; j < 5; j++) {
                int finalMarks = students[i].getInternalMarks()[j] + students[i].getExternalMarks()[j];
                System.out.println("Subject " + (j + 1) + " Final Marks: " + finalMarks);
            }
        }

        System.out.println("Dhruvdeep Nayak-093");

        sc.close();
    }
}
